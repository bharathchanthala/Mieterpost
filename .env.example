# TEMPLATE ONLY. Never put real passwords or keys in this file: it is
# published on GitHub. Real values go in .env.local, which Git ignores.

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mieterpost"

# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY="your-key-here"
# Optional: which Gemini model to use. Defaults to gemini-3.5-flash-lite.
# AI_MODEL="gemini-3.5-flash-lite"

# Optional: how long the workflow waits before flagging a follow-up.
# Defaults to 3 days ("3d"). Use "30s" to see it happen during a demo.
# FOLLOW_UP_DELAY="30s"
